---
import "../styles/global.css";
import StatCard from "../components/StatCard.astro";
import SolicitationCard, { type Sol } from "../components/SolicitationCard.astro";
import dashboard from "../data/dashboard.json";

const { generated_at, source, stats } = dashboard;
const sols = dashboard.solicitations as Sol[];

const tierOf = (score: number): "high" | "medium" | "low" =>
  score >= 70 ? "high" : score >= 40 ? "medium" : "low";

const tiers = [
  { key: "high" as const, label: "High Priority", range: "score ≥ 70" },
  { key: "medium" as const, label: "Medium Priority", range: "score 40–69" },
  { key: "low" as const, label: "Low Priority", range: "score < 40" },
];

const byTier = tiers.map((t) => ({
  ...t,
  sols: sols.filter((s) => tierOf(s.pricing_score) === t.key),
}));

const pscCodes = [...new Set(sols.map((s) => s.psc_code).filter(Boolean))].sort();

const generatedDate = new Date(generated_at);
const generatedLabel = generatedDate.toLocaleString("en-US", {
  dateStyle: "medium",
  timeStyle: "short",
  timeZone: "UTC",
}) + " UTC";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="GovScout dashboard — federal solicitations scored for pricing signals, with NSN/part/qty line items extracted for quoting."
    />
    <title>GovScout — Solicitation Pricing-Signal Dashboard</title>
  </head>
  <body>
    {source === "demo" && <div class="demo-banner">Demo data — sample solicitations, not live postings</div>}

    <header class="site-header">
      <div class="wrap">
        <div class="brand">
          <h1>Gov<span class="scout">Scout</span></h1>
          <span class="source-badge">source: {source}</span>
        </div>
        <p class="tagline">
          Federal solicitations scored for online-pricing signals — NSN, part
          number, and quantity line items extracted and ranked for quoting.
        </p>
        <div class="header-meta-row">
          <p class="generated">generated {generatedLabel}</p>
          <a href="/trends" class="trends-jump-btn">📊 View Procurement Trends →</a>
        </div>
      </div>
    </header>

    <main class="wrap">
      <section class="stats" aria-label="Pipeline summary">
        <StatCard value={stats.fetched} label="Fetched" />
        <StatCard value={stats.with_pricing_signals} label="Pricing signals" variant="accent" />
        <StatCard value={stats.high} label="High" variant="tier-high" />
        <StatCard value={stats.medium} label="Medium" variant="tier-medium" />
        <StatCard value={stats.low} label="Low" variant="tier-low" />
      </section>

      {stats.by_weekday && stats.by_fsc && (
        <section class="trends-section" id="trends">
          <div class="trends-header">
            <h2 class="trends-title">📊 Procurement Velocity & FSC Supply Trends</h2>
            <p class="trends-subtitle">Automated weekly release volume patterns across Federal Supply Codes</p>
          </div>
          <div class="trends-grid">
            <div class="trend-card">
              <div class="trend-card-title">Release Volume by Day of Week</div>
              <div class="weekday-bars">
                {Object.entries(stats.by_weekday).map(([day, count]) => {
                  const maxCount = Math.max(...Object.values(stats.by_weekday as Record<string, number>), 1);
                  const heightPercent = Math.max(12, Math.round(((count as number) / maxCount) * 100));
                  return (
                    <div class="bar-col">
                      <span class="bar-count">{count as number}</span>
                      <div class="bar-fill" style={`height: ${heightPercent}%`} />
                      <span class="bar-label">{day}</span>
                    </div>
                  );
                })}
              </div>
            </div>

            <div class="trend-card">
              <div class="trend-card-title">Top Active Defense Supply Codes (FSC)</div>
              <div class="fsc-list">
                {(stats.by_fsc as Array<{ code: string; name: string; count: number }>).map((item) => (
                  <div class="fsc-row">
                    <div>
                      <span class="fsc-code-badge">FSC {item.code}</span>
                      <span class="fsc-name">{item.name}</span>
                    </div>
                    <span class="fsc-count-badge">{item.count}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </section>
      )}

      <div class="filter-bar">
        <input
          id="search"
          class="search-input"
          type="search"
          placeholder="Search title, agency, sol #, or NSN…"
          autocomplete="off"
        />
        <select id="psc-filter" class="psc-select" aria-label="Filter by PSC code">
          <option value="">All PSC codes</option>
          {pscCodes.map((code) => <option value={code}>{code}</option>)}
        </select>
        <div class="tier-filters" role="group" aria-label="Filter by tier">
          <button class="tier-btn active" data-tier-filter="all">All</button>
          <button class="tier-btn" data-tier-filter="high">High</button>
          <button class="tier-btn" data-tier-filter="medium">Medium</button>
          <button class="tier-btn" data-tier-filter="low">Low</button>
        </div>
        <span class="result-count" id="result-count"></span>
      </div>

      {byTier.map(({ key, label, range, sols: group }) =>
        group.length > 0 && (
          <section class="tier-section" data-tier-section={key}>
            <h2 class:list={["tier-heading", `tier-${key}`]}>
              {label}
              <span class="count">{range} — {group.length} solicitation{group.length === 1 ? "" : "s"}</span>
            </h2>
            <div class="cards">
              {group.map((sol) => <SolicitationCard sol={sol} tier={key} />)}
            </div>
          </section>
        )
      )}

      <div class="no-results" id="no-results">
        No solicitations match the current filters.
      </div>
    </main>

    <footer class="site-footer">
      <div class="wrap">
        Built with GovScout — solicitation monitoring, pricing-signal detection,
        and NSN/part/qty extraction. Data stored locally in SQLite; this page is
        a static export.
      </div>
    </footer>

    <script>
      const searchInput = document.getElementById("search");
      const pscSelect = document.getElementById("psc-filter");
      const tierButtons = document.querySelectorAll("[data-tier-filter]");
      const cards = document.querySelectorAll(".card");
      const sections = document.querySelectorAll("[data-tier-section]");
      const noResults = document.getElementById("no-results");
      const resultCount = document.getElementById("result-count");
      const total = cards.length;

      let activeTier = "all";

      function applyFilters() {
        const query = searchInput.value.trim().toLowerCase();
        const psc = pscSelect.value;
        let visible = 0;

        cards.forEach((card) => {
          const matchesTier = activeTier === "all" || card.dataset.tier === activeTier;
          const matchesPsc = !psc || card.dataset.psc === psc;
          const matchesQuery = !query || card.dataset.search.includes(query);
          const show = matchesTier && matchesPsc && matchesQuery;
          card.hidden = !show;
          if (show) visible++;
        });

        sections.forEach((section) => {
          const anyVisible = section.querySelector(".card:not([hidden])") !== null;
          section.style.display = anyVisible ? "" : "none";
        });

        noResults.classList.toggle("visible", visible === 0);
        resultCount.textContent = visible === total
          ? `${total} solicitations`
          : `${visible} of ${total} shown`;
      }

      searchInput.addEventListener("input", applyFilters);
      pscSelect.addEventListener("change", applyFilters);
      tierButtons.forEach((btn) => {
        btn.addEventListener("click", () => {
          tierButtons.forEach((b) => b.classList.remove("active"));
          btn.classList.add("active");
          activeTier = btn.dataset.tierFilter;
          applyFilters();
        });
      });

      applyFilters();
    </script>
  </body>
</html>
